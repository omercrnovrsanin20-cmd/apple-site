# Supabase Postgres connection strings -- see README for where to find these
# in your Supabase project (Project Settings -> Database).
# DATABASE_URL: the pooled "Transaction" connection string (port 6543), used
#   by the running app.
# DIRECT_URL: the direct connection string (port 5432), used only for schema
#   migrations.
DATABASE_URL=""
DIRECT_URL=""

# Supabase project URL + service role key (Project Settings -> API), used
# server-side only to read/write the private "photos" storage bucket. Never
# expose the service role key to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Demo/dev values below work out of the box after `cp .env.example .env`.
# Change them before using this anywhere beyond local development.
AUTH_SECRET="dev-only-change-me-super-secret-auth-key"
STAFF_PASSWORD="12345678"
OWNER_EMAIL="owner@detailing.me"
OWNER_PASSWORD="OwnerSecure2026!"

# Base URL this app runs on (used to build the Google OAuth redirect URI).
APP_URL="http://localhost:3000"

# Optional: "Continue with Google" on the Customer portal. Leave both blank
# to keep email/password-only login -- the button still shows but will
# show a friendly error until these are set. See README for setup steps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
